; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Carbon and Capital V0.5.0"
config/version="0.5.0"
run/main_scene="res://scenes/demo_startup.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://scenes/icon.svg"

[autoload]

GoodHoverRegistry="*res://scripts/good_hover_registry.gd"
DS="*res://scripts/ds.gd"
MapStyle="*res://scripts/map_style.gd"
UiPrefs="*res://scripts/ui_prefs.gd"
Audio="*res://scripts/audio.gd"
Catalog="*res://scripts/catalog.gd"
MarketState="*res://scripts/market_state.gd"
SpecialOrderState="*res://scripts/special_order_state.gd"
Stockpile="*res://scripts/stockpile.gd"
EconomyConfig="*res://scripts/economy_config.gd"
TransportService="*res://scripts/transport_service.gd"
MatchState="*res://scripts/match_state.gd"
BuildingState="*res://scripts/building_state.gd"
ResearchState="*res://scripts/research_state.gd"
AdvisorState="*res://scripts/advisor_state.gd"
BuildingWorks="*res://scripts/building_works.gd"
LabourState="*res://scripts/labour_state.gd"
TransportState="*res://scripts/transport_state.gd"
Construction="*res://scripts/construction.gd"
LoanState="*res://scripts/loan_state.gd"
Power="*res://scripts/power.gd"
TurnManager="*res://scripts/turn_manager.gd"
Production="*res://scripts/production.gd"
CompanyRankings="*res://scripts/company_rankings.gd"
VictoryState="*res://scripts/victory_state.gd"
CostSolver="*res://scripts/cost_solver.gd"
BuildMode="*res://scripts/build_mode.gd"
MapMode="*res://scripts/map_mode.gd"
PanelStack="*res://scripts/panel_stack.gd"
TurnProfiler="*res://scripts/turn_profiler.gd"
RoadWorks="*res://scripts/road_works.gd"
RunMetrics="*res://scripts/run_metrics.gd"
EventScheduler="*res://scripts/event_scheduler.gd"
PolicyState="*res://scripts/policy_state.gd"
Modifiers="*res://scripts/modifier_state.gd"
DecisionState="*res://scripts/decision_state.gd"
SolvencyState="*res://scripts/solvency_state.gd"
TurnBriefing="*res://scripts/turn_briefing.gd"
SaveLoad="*res://scripts/save_load.gd"
SessionLog="*res://scripts/session_log.gd"
TelemetryState="*res://scripts/telemetry_state.gd"
PlayerProfile="*res://scripts/player_profile.gd"
LoadPacing="*res://scripts/load_pacing.gd"
Tutorial="*res://scripts/tutorial/tutorial_engine.gd"
MiniQuest="*res://scripts/mini_quest.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=2360
window/size/window_height_override=1328
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/demo_export/plugin.cfg")

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"compress/rdo_quality_loss": 0.0,
"compress/uastc_level": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"process/channel_remap/alpha": 3,
"process/channel_remap/blue": 2,
"process/channel_remap/green": 1,
"process/channel_remap/red": 0,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

