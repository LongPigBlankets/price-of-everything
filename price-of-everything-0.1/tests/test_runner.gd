	_check(VictoryState.win_threshold_for_turn(235) == 3000, "victory bar: turn 235 = 3000 (3 tracks)")
	_check(VictoryState.win_threshold_for_turn(300) == 4000, "victory bar: turn 300 = 4000 (4 tracks)")
