[gd_scene format=4]

[ext_resource type="Script" path="res://scripts/section_card.gd" id="1"]

[node name="SectionCard" type="PanelContainer"]
theme_type_variation = &"Card"
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Icon" type="TextureRect" parent="Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5
visible = false

[node name="Title" type="Label" parent="Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Section"
text = "SECTION"

[node name="Content" type="VBoxContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8
